Variable nombre, resultat : Nombre

Début

    Afficher "Entrez un nombre"
    Lire nombre

Si nombre % 2 = 0 Alors
resultat <- nombre * 2
Sinon
resultat <- nombre
FinSi

Afficher resultat

Fin

