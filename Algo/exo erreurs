Variable taille_tableau, i, aiguille, compteur : Nombre 
Début 
     notes <- [2,9,5,7,1,4,5,6,8,8,2,1,4,7,9] 
    taille_tableau <- 15
    compteur <- 0 
    Afficher "Choisissez le nombre aiguille" 
